{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Moxie",
  "version": "0.3.2",
  "identifier": "dev.moxie.terminal",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Moxie — AI Terminal",
        "width": 1440,
        "height": 880,
        "minWidth": 900,
        "minHeight": 500,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQwNTAyN0E0M0M3ODcyRTAKUldUZ2NuZzhwQ2RRMEhhVWJqMGREOW90MHFSK09aYXRJWHJZK24ybDJCc3J6YSs5VDRMRU1GU3IK",
      "endpoints": [
        "https://github.com/VijinV/term/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
